{
  "name": "exchange-company-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "stock-exchange/backend/exchange-company-service",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn spring-boot:run",
        "cwd": "stock-exchange/backend/exchange-company-service"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn clean package",
        "cwd": "stock-exchange/backend/exchange-company-service"
      }
    }
  },
  "tags": ["type:backend", "platform:java", "scope:exchange"],
  "implicitDependencies": ["stocket-market-bom"]
}
