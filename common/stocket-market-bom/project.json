{
  "name": "stocket-market-bom",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["type:build-config", "platform:java", "scope:common"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn install -DskipTests",
        "cwd": "common/stocket-market-bom"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mvn validate",
        "cwd": "common/stocket-market-bom"
      }
    }
  }
}
