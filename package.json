{
  "name": "stock-market-demo",
  "version": "0.1.0",
  "description": "Stock Market Demo - Banking and Trading Platform",
  "private": true,
  "scripts": {
    "nx": "nx",
    "dev": "nx run-many --target=serve --all --parallel",
    "dev:bank": "nx serve frontend-bank",
    "dev:exchange": "nx serve frontend-exchange",
    "dev:backend:bank": "nx serve backend-bank",
    "dev:backend:exchange": "nx serve backend-exchange",
    "dev:all-frontends": "nx run-many --target=serve --projects=frontend-bank,frontend-exchange --parallel",
    "dev:all-backends": "nx run-many --target=serve --projects=backend-bank,backend-exchange --parallel",
    "dev:user-service": "nx serve user-service",
    "dev:client-service": "nx serve client-service",
    "dev:portfolio-service": "nx serve portfolio-service",
    "dev:microservices": "nx run-many --target=serve --projects=user-service,client-service,portfolio-service --parallel",
    "dev:all": "nx run-many --target=serve --all --parallel",
    "build": "nx run-many --target=build --all",
    "build:bank": "nx build frontend-bank",
    "build:exchange": "nx build frontend-exchange",
    "build:backend:bank": "nx build backend-bank",
    "build:backend:exchange": "nx build backend-exchange",
    "test": "nx test",
    "test:bank": "nx test frontend-bank",
    "test:exchange": "nx test frontend-exchange",
    "test:backend:bank": "nx test backend-bank",
    "test:backend:exchange": "nx test backend-exchange",
    "lint": "nx lint",
    "lint:bank": "nx lint frontend-bank",
    "lint:exchange": "nx lint frontend-exchange",
    "lint:backend:bank": "nx lint backend-bank",
    "lint:backend:exchange": "nx lint backend-exchange",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:lint": "nx affected --target=lint"
  },
  "devDependencies": {
    "@nx/eslint": "23.3.0",
    "@nx/maven": "^23.3.0",
    "@nx/react": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "nx": "23.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "keywords": [
    "stock-market",
    "banking",
    "trading",
    "monorepo",
    "nx"
  ],
  "author": "Sébastien Gérard",
  "license": "MIT"
}
